{
  "name": "newsrelay",
  "version": "5.0.0",
  "private": true,
  "description": "Broadcast News Automation",
  "author": "S-AI Media Works",
  "main": "dist/main/main.cjs",
  "scripts": {
    "dev": "npm run build && electron .",
    "build": "npm run typecheck && vite build && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "format": "prettier --write src tests scripts *.json *.ts *.mjs *.html docs AGENTS.md README.md",
    "format:check": "prettier --check src tests scripts *.json *.ts *.mjs *.html docs AGENTS.md README.md",
    "test": "vitest",
    "test:run": "vitest run",
    "test:smoke": "node scripts/smoke.mjs",
    "package": "npm run build && electron-builder --dir --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "security:scan": "node scripts/secret-scan.mjs",
    "postinstall": "node node_modules/electron/install.js"
  },
  "dependencies": {
    "fast-xml-parser": "^5.2.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@playwright/test": "^1.55.0",
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.44.0",
    "vite": "8.3.0",
    "vitest": "^4.0.0"
  },
  "build": {
    "appId": "com.saimediaworks.newsrelay",
    "productName": "NewsRelay",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "signAndEditExecutable": true,
      "icon": "build/newsrelay.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "NewsRelay-Setup-${version}.exe",
      "deleteAppDataOnUninstall": false
    },
    "copyright": " "
  },
  "type": "module"
}
